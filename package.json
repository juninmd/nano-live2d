{
  "name": "nano-live2d-frontend",
  "version": "2.0.0",
  "description": "Browser frontend for the nano-live2d Live2D avatar (TypeScript + ESM)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
